VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: Cloudflare Turnstile site key (public by design — safe to embed
# client-side, unlike the Turnstile *secret* key, which only ever goes into
# Supabase's Auth settings). Leave unset to skip the captcha in local dev.
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key
